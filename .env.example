# Servidor Xiaomi con Linux. IP de su red local; no abras puertos en el router.
# 127.0.0.1 deja el acceso limitado al propio equipo hasta configurar la IP LAN.
PHOTOHEARTH_BIND_IP=127.0.0.1
PHOTOHEARTH_DOMAIN=photos.home.arpa

# Volumen Docker por defecto. También admite una ruta absoluta ya preparada:
# PHOTOHEARTH_STORAGE=/srv/photohearth/data
PHOTOHEARTH_STORAGE=photohearth_data_pg

# PostgreSQL: crear data/deployment/postgres-password antes del primer arranque.
# No reutilizar el volumen SQLite anterior. Ver deploy/POSTGRES.md.
